# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# Secrets / local config — copy .env.example to .env instead
.env

# User data lives outside version control (build plan §7)
data/
uploads/
*.db
# ...but `data/` above matches at any depth, and the vendored design skills in
# .claude/skills each ship their corpus in a folder of that name — the CSVs the
# skills exist to search. Without this negation they are silently untracked and
# every one of those skills is dead on a fresh clone.
!.claude/skills/**/data/

# Tooling caches
.pytest_cache/

# Editor state — machine-local, not project config
.vscode/
.idea/

# Subagent worktrees (session-local)
.claude/worktrees/

# Playwright probe screenshots (scratchpad/ui-sweeps write here when SCRATCH is unset)
shots/
.gate/
